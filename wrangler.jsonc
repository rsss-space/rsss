{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rsss",
	"main": "src/server/index.ts",
	"compatibility_date": "2025-01-22",
	"compatibility_flags": [
		"nodejs_compat"
	],

	/**
	 * Durable Objects - each user gets their own DO with SQLite
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_DO",
				"class_name": "RsssUserDO"
			},
			{
				"name": "REGISTRY_DO",
				"class_name": "RsssRegistryDO"
			}
		]
	},

	/**
	 * Durable Object migrations.
	 * RsssUserDO is SQLite-backed (uses ctx.storage.sql).
	 *
	 * This is the REAL applied lineage: the class was first created as
	 * CollieUserDO (v1), renamed to UserDO (v2), then renamed to
	 * RsssUserDO (v3). The deployed rsss and rsss-staging workers record
	 * migration_tag "v2", so v1+v2 must stay byte-for-byte intact and the
	 * latest rename is appended as v3. Do NOT collapse or rewrite earlier
	 * tags -- re-creating an already-existing class makes Cloudflare reject
	 * the deploy (error 10074).
	 *
	 * Migrations are NOT inherited into named environments, so they must
	 * also be declared inside env.staging and env.production below.
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CollieUserDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["CollieUserDO"],
			"new_sqlite_classes": ["UserDO"]
		},
		{
			"tag": "v3",
			"renamed_classes": [
				{ "from": "UserDO", "to": "RsssUserDO" }
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["RsssRegistryDO"]
		}
	],

	/**
	 * KV namespace for user session data and user->DO mappings
	 */
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "43728a08638d483d80bfb830d2cd4dc5",
			
			// Optional: preview_id used for `wrangler dev` / local dev
			"preview_id": "ab4cfea82e4546ca8ec79170aaabde38"
		},
		{
			"binding": "BLURHASH_KV",
			"id": "f1ffa380aea548aebc5c83fb19ca8de7",
			"preview_id": "7361bc827bd143aa82a5770bfc3e3a25"
		},
		{
			"binding": "HTML_KV",
			"id": "8576d34d4e0a46d8bd2567339eeeed8f",
			"preview_id": "3051be85a6614268b5497717ff74e596"
		}
	],

	/**
	 * Queue infrastructure for async BlurHash generation
	 */
	"queues": {
		"producers": [
			{
				"binding": "BLURHASH_QUEUE",
				"queue": "blurhash-jobs"
			},
			{
				"binding": "ARTICLE_FETCH_QUEUE",
				"queue": "article-fetch-jobs"
			}
		],
		"consumers": [
			{
				"queue": "blurhash-jobs",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "blurhash-dlq"
			},
			{
				"queue": "article-fetch-jobs",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "article-fetch-dlq"
			}
		]
	},

	/**
	 * Static Assets (Preact frontend)
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		// The @cloudflare/vite-plugin emits the client SPA into
		// public/client/ (and the worker build into public/rsss/).
		// ASSETS must point at the client output, not public/ itself,
		// or the SPA root index.html is missing and / 404s.
		"directory": "./public/client",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},

	"env": {
		"staging": {
			"name": "rsss-staging",
			"observability": {
				"enabled": true
			},
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "staging.rsss.space",
					"custom_domain": true
				}
			],
			"vars": {
				"NODE_ENV": "staging",
				"APP_ORIGIN": "https://staging.rsss.space"
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "USER_DO",
						"class_name": "RsssUserDO"
					},
					{
						"name": "REGISTRY_DO",
						"class_name": "RsssRegistryDO"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["CollieUserDO"]
				},
				{
					"tag": "v2",
					"deleted_classes": ["CollieUserDO"],
					"new_sqlite_classes": ["UserDO"]
				},
				{
					"tag": "v3",
					"renamed_classes": [
						{ "from": "UserDO", "to": "RsssUserDO" }
					]
				},
				{
					"tag": "v4",
					"new_sqlite_classes": ["RsssRegistryDO"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSIONS",
					"id": "ab4cfea82e4546ca8ec79170aaabde38",
					"preview_id": "ab4cfea82e4546ca8ec79170aaabde38"
				},
				{
					"binding": "BLURHASH_KV",
					"id": "7361bc827bd143aa82a5770bfc3e3a25",
					"preview_id": "7361bc827bd143aa82a5770bfc3e3a25"
				},
				{
					"binding": "HTML_KV",
					"id": "3051be85a6614268b5497717ff74e596",
					"preview_id": "3051be85a6614268b5497717ff74e596"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "BLURHASH_QUEUE",
						"queue": "blurhash-jobs-staging"
					},
					{
						"binding": "ARTICLE_FETCH_QUEUE",
						"queue": "article-fetch-jobs-staging"
					}
				],
				"consumers": [
					{
						"queue": "blurhash-jobs-staging",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 3,
						"dead_letter_queue": "blurhash-dlq-staging"
					},
					{
						"queue": "article-fetch-jobs-staging",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 3,
						"dead_letter_queue": "article-fetch-dlq-staging"
					}
				]
			}
		},
		"production": {
			"name": "rsss",
			"durable_objects": {
				"bindings": [
					{
						"name": "USER_DO",
						"class_name": "RsssUserDO"
					},
					{
						"name": "REGISTRY_DO",
						"class_name": "RsssRegistryDO"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["CollieUserDO"]
				},
				{
					"tag": "v2",
					"deleted_classes": ["CollieUserDO"],
					"new_sqlite_classes": ["UserDO"]
				},
				{
					"tag": "v3",
					"renamed_classes": [
						{ "from": "UserDO", "to": "RsssUserDO" }
					]
				},
				{
					"tag": "v4",
					"new_sqlite_classes": ["RsssRegistryDO"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSIONS",
					"id": "43728a08638d483d80bfb830d2cd4dc5",
					"preview_id": "ab4cfea82e4546ca8ec79170aaabde38"
				},
				{
					"binding": "BLURHASH_KV",
					"id": "f1ffa380aea548aebc5c83fb19ca8de7",
					"preview_id": "7361bc827bd143aa82a5770bfc3e3a25"
				},
				{
					"binding": "HTML_KV",
					"id": "8576d34d4e0a46d8bd2567339eeeed8f",
					"preview_id": "3051be85a6614268b5497717ff74e596"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "BLURHASH_QUEUE",
						"queue": "blurhash-jobs"
					},
					{
						"binding": "ARTICLE_FETCH_QUEUE",
						"queue": "article-fetch-jobs"
					}
				],
				"consumers": [
					{
						"queue": "blurhash-jobs",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 3,
						"dead_letter_queue": "blurhash-dlq"
					},
					{
						"queue": "article-fetch-jobs",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 3,
						"dead_letter_queue": "article-fetch-dlq"
					}
				]
			},
			"vars": {
				"NODE_ENV": "production"
			}
		}
	},

	"observability": {
		"enabled": true
	},

	"dev": {
		"port": 9999
	}
}
