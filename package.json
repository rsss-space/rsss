{
  "type": "module",
  "private": "true",
  "version": "0.0.0",
  "main": "public/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "stylelint": "stylelint \"**/*.css\" --ignore-pattern \"public/**\"",
    "build-tests": "esbuild test/index.ts --bundle --format=cjs --keep-names > test/test-bundle.js",
    "test": "node test/run-all-tests.mjs",
    "test:browser": "esbuild ./test/browser-tests.ts --bundle --loader:.css=text --loader:.wasm=dataurl --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts --alias:@stripe/stripe-js=./test/stripe-js-stub.ts --alias:@stripe/stripe-js/pure=./test/stripe-js-stub.ts | tapout -t 180000",
    "tail:staging": "wrangler tail --env staging --format pretty",
    "typecheck": "tsc --noEmit",
    "test:sync": "esbuild ./test/sync.ts --bundle | tapout",
    "test:db": "esbuild ./test/db-adapter.ts --bundle | tapout",
    "test:lww": "esbuild ./test/server-lww.ts --bundle | tapout",
    "test:local-first": "esbuild ./test/local-first-settings.ts --bundle | tapout",
    "test:paint-cache": "esbuild ./test/paint-cache.ts --bundle | tapout",
    "test:paint-cache-bootstrap": "esbuild ./test/paint-cache-bootstrap.ts --bundle | tapout",
    "test:paint-cache-cleanup": "esbuild ./test/paint-cache-cleanup.ts --bundle | tapout",
    "test:sqlite-init": "esbuild ./test/sqlite-init.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:local-adapter": "esbuild ./test/local-adapter.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:adapter-factory": "esbuild ./test/adapter-factory.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:sync-billing-recovery": "esbuild ./test/sync-billing-recovery.ts --bundle | tapout",
    "test:pull-sync": "esbuild ./test/pull-sync.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:push-sync": "esbuild ./test/push-sync.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:feed-resolve-state": "esbuild ./test/feed-resolve-state.ts --bundle --loader:.wasm=dataurl --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts | tapout",
    "test:resolve-convergence-signal-refresh": "esbuild ./test/resolve-convergence-signal-refresh.ts --bundle --loader:.wasm=dataurl --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts | tapout",
    "test:bootstrap": "esbuild ./test/bootstrap.ts --bundle --loader:.wasm=dataurl | tapout",
    "test:cache-status": "node test/run-cache-status.mjs",
    "test:sqlite-worker": "esbuild test/sqlite-worker.ts --bundle | tapout",
    "test:feed": "esbuild test/feed-fetch-security.ts --bundle | tapout",
    "test:server-fk": "node test/run-server-foreign-keys.mjs",
    "test:registry": "node test/run-registry.mjs",
    "test:tab-coordination": "esbuild test/tab-coordination.ts --bundle | tapout",
    "test:api-router": "esbuild test/api-router.ts --bundle --loader:.wasm=dataurl --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | tapout",
    "test:feeds-refresh-pool": "esbuild test/feeds-refresh-pool.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:bluesky-follows": "esbuild ./test/bluesky-follows.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:graph-following": "esbuild ./test/graph-following.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:list-remote-subscriptions": "esbuild ./test/list-remote-subscriptions.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:subscription-reconcile": "esbuild ./test/subscription-reconcile.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:do-id-params": "esbuild ./test/do-id-params.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:admin-auth": "esbuild ./test/admin-auth.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:admin-refresh-all": "esbuild ./test/admin-refresh-all.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:recommendations-route": "esbuild ./test/recommendations-route.ts --bundle --platform=node --format=esm --external:./src/server/blurhash-runtime.js --external:stripe --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | node --input-type=module | tap-spec",
    "test:sentry-wiring": "esbuild ./test/sentry-wiring.ts --bundle --loader:.wasm=dataurl --alias:cloudflare:workers=./test/cloudflare-workers-stub.ts --alias:@sentry/cloudflare=./test/sentry-cloudflare-stub.ts | tapout",
    "test:report-error": "node test/run-report-error.mjs",
    "test:lazy-html": "esbuild ./test/lazy-html.ts --bundle | tapout",
    "test:server-import-shape": "esbuild ./test/server-import-shape.ts --bundle --platform=node --format=esm | node --input-type=module | tap-spec",
    "test:lazy-html-handler": "node test/run-lazy-html-handler.mjs",
    "test:lazy-html-routing": "node test/run-lazy-html-routing.mjs",
    "test:initial-feed": "esbuild ./test/initial-feed.ts --bundle | tapout",
    "test:feed-reader-render-state": "esbuild ./test/feed-reader-render-state.ts --bundle --loader:.css=text | tapout",
    "test:paint-cache-slow-billing": "node test/paint-cache-slow-billing.mjs",
    "test:signup:server": "node test/run-signup-server.mjs",
    "test:signup:ui": "esbuild ./test/signup-ui.ts --bundle --loader:.css=text | tapout",
    "test:signup": "npm run test:signup:server && npm run test:signup:ui",
    "test:headers": "node test/run-header-tests.mjs",
    "build": "mkdir -p ./public && rm -rf ./public/* && npx vite build $([ \"$NODE_ENV\" != \"production\" ] && echo \"--mode staging\") && cp script/assetsignore public/client/.assetsignore",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run build",
    "predeploy:production": "node script/predeploy-production.mjs",
    "deploy:staging": "node script/deploy.mjs staging",
    "deploy:production": "node script/deploy.mjs production",
    "db:reset": "rm -rf .wrangler/state"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.5",
    "@preact/signals": "^2.5.1",
    "@sentry/browser": "^10.55.0",
    "@sentry/cloudflare": "^10.55.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@stripe/stripe-js": "^4.10.0",
    "@substrate-system/a11y": "^0.0.17",
    "@substrate-system/blur-hash": "^0.0.40",
    "@substrate-system/button": "^0.0.43",
    "@substrate-system/check-box": "^0.0.11",
    "@substrate-system/css-normalize": "^0.0.13",
    "@substrate-system/details-summary": "^0.0.2",
    "@substrate-system/dialog": "^0.0.30",
    "@substrate-system/hamburger-two": "^0.0.11",
    "@substrate-system/icons": "^0.1.29",
    "@substrate-system/radio-input": "^0.0.11",
    "@substrate-system/routes": "^5.0.0",
    "@substrate-system/state": "^0.0.4",
    "@substrate-system/toast": "^0.0.10",
    "@substrate-system/tool-tip": "^0.0.5",
    "@types/dompurify": "^3.0.5",
    "autumn-js": "^1.2.12",
    "blurhash": "^2.0.5",
    "dompurify": "^3.4.1",
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.11.3",
    "htm": "^3.1.1",
    "ky": "^1.14.1",
    "preact": "^10.28.0",
    "resend": "^6.12.2",
    "route-event": "^8.1.0",
    "stripe": "17.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.19.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@preact/preset-vite": "^2.9.4",
    "@sentry/vite-plugin": "^5.3.0",
    "@substrate-system/debug": "^0.9.60",
    "@substrate-system/tapout": "^0.0.35",
    "@substrate-system/tapzero": "^0.10.16",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.19.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "lightningcss": "^1.30.2",
    "markdown-toc": "^1.2.0",
    "strip-json-comments": "^3.1.1",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^39.0.1",
    "tap-spec": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.94.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
